{
  "name": "planner-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "pnpm build && wrangler dev",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "preview": "vite preview",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "test": "vitest run",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run --env production",
    "deploy": "pnpm build && wrangler deploy --env production",
    "api:sync": "tsx scripts/openapi/sync-openapi.ts && biome format --write openapi/openapi.json",
    "api:generate": "orval",
    "api:update": "pnpm api:sync && pnpm api:generate",
    "api:check": "tsx scripts/openapi/check-openapi.ts",
    "architecture": "CHOKIDAR_USEPOLLING=1 steiger ./src",
    "check": "pnpm api:check && pnpm format:check && pnpm lint && pnpm architecture && pnpm test && pnpm deploy:dry-run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{css,html,js,jsx,json,md,mjs,ts,tsx}": "biome check --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.5.7",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "axios": "1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router": "8.3.0",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^17.3.0",
    "orval": "8.23.0",
    "steiger": "0.6.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.1.1",
    "vitest": "4.1.10",
    "wrangler": "4.127.1",
    "yaml": "2.9.0"
  }
}
