{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "a4c9bdc930a7c203670462011024234e",
  "name": "planner-frontend-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "services": [{ "binding": "API", "service": "planner-api" }],
  "env": {
    "production": {
      "name": "app",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*"]
      },
      "services": [{ "binding": "API", "service": "planner-api" }]
    }
  }
}
