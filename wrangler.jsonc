{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "april-planner-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "services": [{ "binding": "API", "service": "free-hosting-starter" }],
  "env": {
    "production": {
      "name": "april-planner",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*"]
      },
      "services": [{ "binding": "API", "service": "free-hosting-starter" }]
    }
  }
}
